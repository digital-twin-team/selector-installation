# Tool versions used by 01-install-tools.sh. kubectl/kind/kustomize/spruce/yaml2json/yq match the vendor's s2ctl.sh.
# Helm is pinned here instead of `curl .../main/scripts/get-helm-3 | bash`; Helm 3.x is what the vendor specs
# were built against (3.x receives security fixes until 2026-11-11, so plan a Helm 4 test with the vendor).
KUBECTL_VERSION=v1.32.4
KIND_VERSION=v0.27.0
KUSTOMIZE_VERSION=v5.7.0
SPRUCE_VERSION=1.29.0
YAML2JSON_VERSION=0.4.0
YQ_VERSION=v4.52.5
HELM_VERSION=v3.21.3

# kubectl, kind, kustomize and helm are verified against the checksum files their publishers ship.
# spruce, yaml2json and yq do not ship a simple .sha256 file. Leave these empty on the first run (the installer
# prints the sha256 it downloaded), then paste the values here so every later run verifies them.
SPRUCE_SHA256=
YAML2JSON_SHA256=
YQ_SHA256=
